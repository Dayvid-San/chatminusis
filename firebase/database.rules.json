{
  "rules": {
    ".read": false,
    ".write": false,
    "messages": {
      ".read": "auth != null && auth.token.email_verified == true",
      ".indexOn": [
        "timestamp"
      ],
      "$messageId": {
        ".write": "auth != null && auth.token.email_verified == true && !data.exists()",
        ".validate": "newData.hasChildren(['senderId', 'senderName', 'text', 'timestamp'])",
        "senderId": {
          ".validate": "newData.val() == auth.uid"
        },
        "senderName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 4000"
        },
        "timestamp": {
          ".validate": "newData.val() == now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified == true",
        ".write": "auth != null && auth.token.email_verified == true && auth.uid == $uid",
        ".validate": "newData.hasChildren(['nickname', 'displayName', 'createdAt'])",
        "nickname": {
          ".validate": "newData.isString() && newData.parent().parent().parent().child('nicknames').child(newData.val()).val() == $uid"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "createdAt": {
          ".validate": "(!data.exists() && newData.val() == now) || newData.val() == data.val()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "nicknames": {
      "$nick": {
        ".read": "auth != null && auth.token.email_verified == true",
        ".write": "auth != null && auth.token.email_verified == true && ((!data.exists() && newData.val() == auth.uid) || (data.val() == auth.uid && !newData.exists() && newData.parent().parent().child('users').child(auth.uid).child('nickname').val() != $nick))",
        ".validate": "newData.isString() && $nick.matches(/^[a-z0-9_.]{3,20}$/) && newData.parent().parent().child('users').child(auth.uid).child('nickname').val() == $nick"
      }
    },
    "blocks": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "$other": {
          ".validate": "newData.val() == true && $other != $uid"
        }
      }
    },
    "reports": {
      "$reportId": {
        ".write": "auth != null && auth.token.email_verified == true && !data.exists()",
        ".validate": "newData.hasChildren(['reporter', 'reported', 'reason', 'createdAt'])",
        "reporter": {
          ".validate": "newData.val() == auth.uid"
        },
        "reported": {
          ".validate": "newData.isString() && newData.val() != auth.uid"
        },
        "reason": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
        },
        "createdAt": {
          ".validate": "newData.val() == now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
