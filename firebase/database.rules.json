{
  "rules": {
    ".read": false,
    ".write": false,

    "messages": {
      ".read": "auth != null && auth.token.email_verified == true",
      ".indexOn": ["timestamp"],
      "$messageId": {
        ".write": "auth != null && auth.token.email_verified == true && !data.exists()",
        ".validate": "newData.hasChildren(['senderId', 'senderName', 'text', 'timestamp'])",
        "senderId": { ".validate": "newData.val() == auth.uid" },
        "senderName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
        "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 4000" },
        "timestamp": { ".validate": "newData.val() == now" },
        "$other": { ".validate": false }
      }
    }
  }
}
